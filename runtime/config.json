{
  "defaults": {
    "agent_id": "main",
    "model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
    "delivery": {
      "recipients": [
        {
          "name": "Momojie",
          "agent_id": "notify",
          "channel": "wecom"
        }
      ]
    }
  },
  "tushare": {
    "credit_limit": 5200
  },
  "quick_news": {
    "enabled": true,
    "interval_minutes": 30,
    "cron": {
      "agent_turn_timeout_seconds": 900,
      "session_poll_timeout_seconds": 900
    }
  },
  "feedback": {
    "enabled": false,
    "interval_minutes": 30,
    "feedback_new_dir": "workspace/feedback/new",
    "feedback_done_dir": "workspace/feedback/done",
    "cron": {
      "session_poll_timeout_seconds": 300,
      "result_wait_timeout_seconds": 600
    }
  },
  "event_review": {
    "enabled": true,
    "schedule_time": "08:00",
    "concurrency": 1
  },
  "iteration_loop": {
    "dev_tasks": {
      "enabled": false
    },
    "enabled": false,
    "interval_minutes": 60
  }
}
