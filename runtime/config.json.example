{
  "_comment": "OpenClaw-Alpha 功能配置（凭据请放在 .env 中，不要写在这里）",

  "defaults": {
    "_comment": "模块公共默认值，模块未设置时自动继承",
    "agent_id": "main",
    "model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
    "delivery": {
      "recipients": [
        {
          "name": "用户名",
          "agent_id": "notify",
          "channel": "wecom"
        }
      ]
    }
  },

  "tushare": {
    "credit_limit": 5200
  },

  "quick_news": {
    "enabled": true,
    "interval_minutes": 30,
    "cron": {
      "agent_turn_timeout_seconds": 900,
      "session_poll_timeout_seconds": 900
    }
  },

  "feedback": {
    "enabled": false,
    "interval_minutes": 30,
    "agent_id": "alpha",
    "model": "openrouter/openrouter/hunter-alpha",
    "feedback_new_dir": "workspace/feedback/new",
    "feedback_done_dir": "workspace/feedback/done",
    "cron": {
      "session_poll_timeout_seconds": 300,
      "result_wait_timeout_seconds": 600
    }
  },

  "event_review": {
    "enabled": true,
    "schedule_time": "08:00",
    "concurrency": 1
  },

  "iteration_loop": {
    "enabled": false,
    "interval_minutes": 60,
    "dev_tasks": {
      "enabled": false
    }
  }
}
